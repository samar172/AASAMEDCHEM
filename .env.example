# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (homebrew/local Postgres):
#   DATABASE_URL="postgres://USER@localhost:5432/aasamed_dev"
#
# Neon (production / Vercel) — use the POOLED connection string (host contains
# "-pooler") and keep sslmode=require:
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgres://localhost:5432/aasamed_dev"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs. Generate a strong value, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
